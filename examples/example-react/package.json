{
  "name": "example-react",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./module/index.js",
  "exports": {
    ".": {
      "module": "./module/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "dist/index.d.ts"
      ]
    }
  },
  "imports": {
    "#css/*.css": {
      "browser": "./dist/#css/*.css",
      "default": "./dist/#css/fallback.js"
    },
    "#css_module/*.css": {
      "browser": "./module/#css/*.css",
      "default": "./module/#css/fallback.js"
    }
  },
  "files": [
    "dist",
    "module"
  ],
  "scripts": {
    "build": "pkg-pack build"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "@types/react": "^19.0.12"
  },
  "devDependencies": {
    "react": "~19.1.0",
    "@types/react": "~19.0.12",
    "pkg-pack": "workspace:^",
    "@pkg-pack/plugin-css-modules": "workspace:^"
  }
}
