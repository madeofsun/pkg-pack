{
  "name": "example-vue-jsx",
  "main": "./dist/index.js",
  "module": "./module/index.js",
  "exports": {
    ".": {
      "module": "./module/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#css_default/*.css": {
      "module": "./dist/#css/*.css",
      "default": "./dist/#css/fallback.js"
    },
    "#css_module/*.css": {
      "module": "./module/#css/*.css",
      "default": "./nodule/#css/fallback.js"
    }
  },
  "files": [
    "#css",
    "dist",
    "module"
  ],
  "scripts": {
    "build": "pkg-pack build"
  },
  "dependencies": {
    "@pkg-pack/interop": "workspace:^",
    "tippy.js": "^6.3.7",
    "mitt": "^3.0.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "pkg-pack": "workspace:^",
    "@pkg-pack/plugin-css-modules": "workspace:^",
    "@pkg-pack/plugin-vue-jsx": "workspace:^"
  }
}
